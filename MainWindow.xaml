<Window x:Class="UnityHubCustom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unity Hub+ (Custom) - 프로젝트 관리 및 레이아웃 초기화"
        Icon="app.ico"
        Height="720" Width="1080"
        MinHeight="600" MinWidth="850"
        Background="#141416"
        WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.RowDefinitions>
            <!-- Header & Navigation Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Status Bar -->
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E1E22" BorderBrush="#2E2E33" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="6" Width="34" Height="34" Margin="0,0,12,0" ClipToBounds="True" Background="#18181B">
                        <Image Source="app.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Unity Hub+" Foreground="#F4F4F5" FontSize="17" FontWeight="Bold"/>
                            <Border Background="#3B2D18" BorderBrush="#D97706" BorderThickness="1" CornerRadius="4" Margin="10,0,0,0" Padding="6,1">
                                <TextBlock Text="Layout Reset" Foreground="#F59E0B" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="프로젝트 관리 및 레이아웃 초기화 실행 도구" Foreground="#8E8E93" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Tabs (Radio-like Buttons) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <RadioButton x:Name="TabProjectsRadio" Content="프로젝트 (Projects)" IsChecked="True"
                                 Checked="TabRadio_Checked"
                                 Foreground="#F4F4F5" FontSize="13" FontWeight="SemiBold"
                                 Margin="0,0,24,0" Cursor="Hand"/>
                    <RadioButton x:Name="TabInstallsRadio" Content="설치된 에디터 (Installs)"
                                 Checked="TabRadio_Checked"
                                 Foreground="#A1A1AA" FontSize="13" FontWeight="SemiBold"
                                 Margin="0,0,24,0" Cursor="Hand"/>
                    <RadioButton x:Name="TabSettingsRadio" Content="설정 및 로그 (Settings &amp; Logs)"
                                 Checked="TabRadio_Checked"
                                 Foreground="#A1A1AA" FontSize="13" FontWeight="SemiBold"
                                 Cursor="Hand"/>
                </StackPanel>

                <!-- Quick Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnAddProject" Content="+ 프로젝트 추가" Style="{StaticResource OpenButtonStyle}" Margin="0,0,10,0" Click="BtnAddProject_Click"/>
                    <Button x:Name="BtnRefresh" Content="⟳ 새로고침" Style="{StaticResource SecondaryButtonStyle}" Click="BtnRefresh_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20,16">
            
            <!-- TAB 1: PROJECTS -->
            <Grid x:Name="ViewProjects" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search and Filters -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBox x:Name="TxtSearch" Style="{StaticResource DarkTextBoxStyle}" 
                                 TextChanged="TxtSearch_TextChanged"
                                 VerticalContentAlignment="Center"
                                 Height="34"/>
                        <TextBlock x:Name="TxtSearchPlaceholder"
                                   Text="🔍 프로젝트 이름 또는 경로 검색..." IsHitTestVisible="False"
                                   Foreground="#71717A" VerticalAlignment="Center" Margin="12,0,0,0"
                                   FontSize="13"/>
                    </Grid>

                    <TextBlock Grid.Column="2" x:Name="TxtProjectCount" Text="0개 프로젝트" Foreground="#A1A1AA" VerticalAlignment="Center" FontSize="13"/>
                </Grid>

                <!-- Projects List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ProjectsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E1E22" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="8"
                                        Margin="0,0,0,10" Padding="16,14">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#25252A"/>
                                                    <Setter Property="BorderBrush" Value="#3F3F46"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Project Info -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <!-- Top Line: Title & Badges -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="#F4F4F5" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                                
                                                <!-- Version Tag -->
                                                <Border Background="#2B2B32" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Margin="12,0,0,0" Padding="8,2">
                                                    <TextBlock Text="{Binding Version}" Foreground="#93C5FD" FontSize="12" FontWeight="SemiBold"/>
                                                </Border>

                                                <!-- Status Tag -->
                                                <Border Background="#1E293B" CornerRadius="4" Margin="8,0,0,0" Padding="8,2">
                                                    <TextBlock Text="{Binding EditorStatusText}" Foreground="{Binding EditorStatusColor}" FontSize="11" FontWeight="Medium"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Middle Line: Path -->
                                            <TextBlock Text="{Binding Path}" Foreground="#71717A" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>

                                            <!-- Bottom Line: Last Modified -->
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBlock Text="최종 수정: " Foreground="#52525B" FontSize="11"/>
                                                <TextBlock Text="{Binding DisplayDate}" Foreground="#A1A1AA" FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Normal Open -->
                                            <Button Content="▶ 열기" Style="{StaticResource OpenButtonStyle}"
                                                    Margin="0,0,8,0" Padding="14,8"
                                                    Tag="{Binding}" Click="BtnOpenProject_Click"
                                                    ToolTip="매칭된 Unity Editor로 프로젝트를 바로 실행합니다."/>

                                            <!-- Reset & Open -->
                                            <Button Content="⚡ 리셋후 열기" Style="{StaticResource ResetOpenButtonStyle}"
                                                    Margin="0,0,8,0" Padding="14,8"
                                                    Tag="{Binding}" Click="BtnResetAndOpenProject_Click"
                                                    ToolTip="프로젝트 Layout(UserSettings, Library)과 Editor Layout(AppData, Registry)을 완전히 초기화한 후 실행합니다."/>

                                            <!-- More Actions Button -->
                                            <Button Content="···" Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="10,8" Tag="{Binding}" Click="BtnMoreOptions_Click">
                                                <Button.ContextMenu>
                                                    <ContextMenu Background="#202024" Foreground="#F4F4F5">
                                                        <MenuItem Header="📁 파일 탐색기에서 열기" Click="MenuOpenExplorer_Click"/>
                                                        <MenuItem Header="⚡ 레이아웃만 초기화 (열지 않음)" Click="MenuResetLayoutOnly_Click"/>
                                                        <Separator Background="#3F3F46"/>
                                                        <MenuItem Header="🗑 목록에서 제거" Click="MenuRemoveProject_Click"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- TAB 2: INSTALLS -->
            <Grid x:Name="ViewInstalls" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="설치된 Unity 에디터" Foreground="#F4F4F5" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="시스템에서 감지되거나 수동으로 등록된 Unity.exe 목록입니다." Foreground="#8E8E93" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" x:Name="BtnAddEditor" Content="+ 에디터 수동 찾기 (Unity.exe)" Style="{StaticResource SecondaryButtonStyle}" Click="BtnAddEditor_Click"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="InstallsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E1E22" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="8"
                                        Margin="0,0,0,10" Padding="16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" Foreground="#F4F4F5" FontSize="15" FontWeight="Bold"/>
                                                <Border Background="#064E3B" CornerRadius="4" Margin="10,0,0,0" Padding="6,2">
                                                    <TextBlock Text="정상 감지됨" Foreground="#34D399" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ExecutablePath}" Foreground="#71717A" FontSize="12" Margin="0,5,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="폴더 열기" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                                    Tag="{Binding}" Click="BtnOpenEditorFolder_Click"/>
                                            <Button Content="제거" Tag="{Binding}" Click="BtnRemoveCustomEditor_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCustom}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- TAB 3: SETTINGS & LOGS -->
            <Grid x:Name="ViewSettings" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Options -->
                <Border Grid.Row="0" Background="#1E1E22" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="레이아웃 초기화 (Reset) 옵션" Foreground="#F4F4F5" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>

                        <CheckBox x:Name="ChkResetProjectLayout" Content="프로젝트 레이아웃 초기화 (&lt;Project&gt;\UserSettings\Layouts, Library\*.dwlt 삭제)"
                                  Foreground="#E4E4E7" FontSize="13" Margin="0,0,0,8" IsChecked="True"/>
                        <CheckBox x:Name="ChkResetEditorLayout" Content="Unity Editor 전역 레이아웃 캐시 초기화 (%APPDATA%\Unity\Editor-5.x\Preferences\Layouts\current 삭제)"
                                  Foreground="#E4E4E7" FontSize="13" Margin="0,0,0,8" IsChecked="True"/>
                        <CheckBox x:Name="ChkResetRegistry" Content="Windows 레지스트리 윈도우 레이아웃/좌표 설정 초기화 (HKCU\Software\Unity Technologies\Unity Editor 5.x)"
                                  Foreground="#E4E4E7" FontSize="13" Margin="0,0,0,8" IsChecked="True"/>
                        <CheckBox x:Name="ChkSyncUnityHub" Content="Unity Hub의 projects-v1.json과 자동 동기화"
                                  Foreground="#E4E4E7" FontSize="13" IsChecked="True" Checked="ChkSyncUnityHub_Changed" Unchecked="ChkSyncUnityHub_Changed"/>
                    </StackPanel>
                </Border>

                <!-- Log Viewer -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="실행 및 초기화 활동 로그" Foreground="#F4F4F5" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="로그 지우기" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="10,4" Click="BtnClearLog_Click"/>
                    </Grid>

                    <TextBox Grid.Row="1" x:Name="TxtLogs" Style="{StaticResource DarkTextBoxStyle}"
                             IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12" Background="#18181B" Foreground="#D4D4D8"/>
                </Grid>
            </Grid>

        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#18181B" BorderBrush="#2E2E33" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatus" Text="준비 완료" Foreground="#9CA3AF" FontSize="12"/>
                <TextBlock Grid.Column="1" x:Name="TxtLastAction" Text="대기 중" Foreground="#6B7280" FontSize="12"/>
            </Grid>
        </Border>

    </Grid>
</Window>
